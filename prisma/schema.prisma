generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  role                   String              @db.VarChar(32)
  name                   String?
  phone                  String?             @unique
  email                  String?             @unique
  passwordHash           String?             @map("password_hash")
  pinHash                String?             @map("pin_hash")
  status                 String              @default("pending")
  cooperativeId          String?             @map("cooperative_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  auditLogs              AuditLog[]          @relation("audit_actor")
  cooperativeMemberships CooperativeMember[]
  exports                Export[]            @relation("exporter")
  farmerProfile          FarmerProfile?
  certifications         LotCertification[]  @relation("certifier")
  lotEvents              LotEvent[]          @relation("lot_actor")
  lots                   Lot[]               @relation("lot_owner")
  parcels                Parcel[]
  eudrDiligenceCreated    EudrDueDiligence[]  @relation("eudr_creator")
  eudrDiligenceApproved   EudrDueDiligence[]  @relation("eudr_approver")
  eudrDeclarations        EudrDeclaration[]   @relation("eudr_submitter")
  cooperative            Cooperative?        @relation("CooperativeUsers", fields: [cooperativeId], references: [id])

  @@map("users")
}

model Cooperative {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  region      String?
  status      String              @default("pending")
  memberCount Int                 @default(0) @map("member_count")
  chiefName   String?             @map("chief_name")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  apiKeys     ApiKey[]
  members     CooperativeMember[]
  exports     Export[]
  lots        Lot[]
  parcels     Parcel[]
  users       User[]              @relation("CooperativeUsers")

  @@map("cooperatives")
}

model CooperativeMember {
  id            String      @id @default(uuid()) @db.Uuid
  cooperativeId String      @map("cooperative_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  role          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([cooperativeId, userId])
  @@map("cooperative_members")
}

model FarmerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  farmName  String?  @map("farm_name")
  location  String?
  language  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("farmer_profiles")
}

model Lot {
  id                  String            @id @default(uuid()) @db.Uuid
  lotCode             String            @unique @map("lot_code")
  ownerId             String            @map("owner_id") @db.Uuid
  cooperativeId       String?           @map("cooperative_id") @db.Uuid
  product             String
  variety             String?
  hsCode              String?           @map("hs_code") @db.VarChar(16)
  originCountry       String?           @map("origin_country") @db.VarChar(3)
  originRegion        String?           @map("origin_region") @db.VarChar(120)
  weightKg            Decimal           @map("weight_kg") @db.Decimal(10, 2)
  harvestDate         DateTime?         @map("harvest_date")
  productionStartDate DateTime?         @map("production_start_date")
  productionEndDate   DateTime?         @map("production_end_date")
  gpsOriginLat        Decimal           @map("gps_origin_lat") @db.Decimal(10, 6)
  gpsOriginLng        Decimal           @map("gps_origin_lng") @db.Decimal(10, 6)
  gpsPrecisionM       Int               @map("gps_precision_m")
  gpsAreaRadiusM      Int               @default(100) @map("gps_area_radius_m")
  status              String            @default("registered") // pending_transcription, registered
  eudrStatus          String            @default("not_started") @map("eudr_status") @db.VarChar(32)
  scaleImageUrl       String?           @map("scale_image_url")
  coopProofImageUrl   String?           @map("coop_proof_image_url")
  blockchainTxHash    String?           @map("blockchain_tx_hash")
  blockchainProofHash String?           @map("blockchain_proof_hash")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  exports             ExportLot[]
  certification       LotCertification?
  events              LotEvent[]
  images              LotImage[]
  parcels             LotParcel[]
  eudrDueDiligence     EudrDueDiligence?
  cooperative         Cooperative?      @relation(fields: [cooperativeId], references: [id])
  owner               User              @relation("lot_owner", fields: [ownerId], references: [id])

  @@map("lots")
  @@index([eudrStatus])
}

model LotEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  lotId               String   @map("lot_id") @db.Uuid
  actorId             String?  @map("actor_id") @db.Uuid
  eventType           String   @map("event_type")
  occurredAt          DateTime @default(now()) @map("occurred_at")
  metadata            Json?
  blockchainTxHash    String?  @map("blockchain_tx_hash")
  blockchainProofHash String?  @map("blockchain_proof_hash")
  actor               User?    @relation("lot_actor", fields: [actorId], references: [id])
  lot                 Lot      @relation(fields: [lotId], references: [id])

  @@map("lot_events")
}

model LotImage {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  url       String
  publicId  String?  @map("public_id")
  checksum  String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  lot       Lot      @relation(fields: [lotId], references: [id])

  @@map("lot_images")
}

model LotCertification {
  id         String   @id @default(uuid()) @db.Uuid
  lotId      String   @unique @map("lot_id") @db.Uuid
  verifierId String   @map("verifier_id") @db.Uuid
  status     String   @default("approved")
  signature  String?
  issuedAt   DateTime @default(now()) @map("issued_at")
  lot        Lot      @relation(fields: [lotId], references: [id])
  verifier   User     @relation("certifier", fields: [verifierId], references: [id])

  @@map("lot_certifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  requestId  String?  @map("request_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("audit_actor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  userId      String?  @map("user_id") @db.Uuid
  route       String
  requestHash String?  @map("request_hash")
  status      String   @default("pending")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("idempotency_keys")
}

model SyncQueue {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  actionType      String    @map("action_type")
  payload         Json
  status          String    @default("pending")
  attemptCount    Int       @default(0) @map("attempt_count")
  nextRetryAt     DateTime? @map("next_retry_at")
  lastError       String?   @map("last_error")
  clientRequestId String?   @map("client_request_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("sync_queue")
}

model Export {
  id            String        @id @default(uuid()) @db.Uuid
  exporterId    String        @map("exporter_id") @db.Uuid
  cooperativeId String?       @map("cooperative_id") @db.Uuid
  status        String        @default("declared")
  eudrStatus    String        @default("not_started") @map("eudr_status") @db.VarChar(32)
  manifestUrl   String?       @map("manifest_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  events        ExportEvent[]
  lots          ExportLot[]
  eudrDueDiligence EudrDueDiligence?
  cooperative   Cooperative?  @relation(fields: [cooperativeId], references: [id])
  exporter      User          @relation("exporter", fields: [exporterId], references: [id])

  @@map("exports")
  @@index([eudrStatus])
}

model ExportLot {
  id       String @id @default(uuid()) @db.Uuid
  exportId String @map("export_id") @db.Uuid
  lotId    String @map("lot_id") @db.Uuid
  export   Export @relation(fields: [exportId], references: [id])
  lot      Lot    @relation(fields: [lotId], references: [id])

  @@unique([exportId, lotId])
  @@map("export_lots")
}

model ExportEvent {
  id         String   @id @default(uuid()) @db.Uuid
  exportId   String   @map("export_id") @db.Uuid
  eventType  String   @map("event_type")
  occurredAt DateTime @default(now()) @map("occurred_at")
  payload    Json?
  export     Export   @relation(fields: [exportId], references: [id])

  @@map("export_events")
}

model Parcel {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  cooperativeId String?  @map("cooperative_id") @db.Uuid
  name         String?   @db.VarChar(120)
  countryCode  String?   @map("country_code") @db.VarChar(3)
  region       String?   @db.VarChar(120)
  district     String?   @db.VarChar(120)
  locality     String?   @db.VarChar(120)
  geometryType String    @map("geometry_type") @db.VarChar(16)
  geometry     Json
  areaHa       Decimal?  @map("area_ha") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lots         LotParcel[]
  deforestationChecks EudrDeforestationCheck[]
  owner        User      @relation(fields: [ownerId], references: [id])
  cooperative  Cooperative? @relation(fields: [cooperativeId], references: [id])

  @@map("parcels")
  @@index([ownerId])
  @@index([cooperativeId])
}

model LotParcel {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  parcelId  String   @map("parcel_id") @db.Uuid
  sharePct  Decimal? @map("share_pct") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")
  lot       Lot      @relation(fields: [lotId], references: [id])
  parcel    Parcel   @relation(fields: [parcelId], references: [id])

  @@unique([lotId, parcelId])
  @@map("lot_parcels")
  @@index([lotId])
  @@index([parcelId])
}

model EudrDueDiligence {
  id                 String    @id @default(uuid()) @db.Uuid
  lotId              String?   @unique @map("lot_id") @db.Uuid
  exportId           String?   @unique @map("export_id") @db.Uuid
  status             String    @default("draft") @db.VarChar(32)
  riskLevel          String?   @map("risk_level") @db.VarChar(16)
  assessmentSummary  String?   @map("assessment_summary")
  mitigationSummary  String?   @map("mitigation_summary")
  createdBy          String    @map("created_by") @db.Uuid
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at")
  declarationRef     String?   @map("declaration_ref") @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lot                Lot?      @relation(fields: [lotId], references: [id])
  export             Export?   @relation(fields: [exportId], references: [id])
  creator            User      @relation("eudr_creator", fields: [createdBy], references: [id])
  approver           User?     @relation("eudr_approver", fields: [approvedBy], references: [id])
  documents          EudrDocument[]
  legalityChecks     EudrLegalityCheck[]
  declarations       EudrDeclaration[]

  @@map("eudr_due_diligence")
  @@index([status])
  @@index([lotId])
  @@index([exportId])
}

model EudrDocument {
  id        String   @id @default(uuid()) @db.Uuid
  ddId      String   @map("dd_id") @db.Uuid
  docType   String   @map("doc_type") @db.VarChar(64)
  url       String
  checksum  String?
  issuedAt  DateTime? @map("issued_at")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  dd        EudrDueDiligence @relation(fields: [ddId], references: [id])

  @@map("eudr_documents")
  @@index([ddId])
}

model EudrDeforestationCheck {
  id         String   @id @default(uuid()) @db.Uuid
  parcelId   String   @map("parcel_id") @db.Uuid
  source     String   @db.VarChar(64)
  checkDate  DateTime @map("check_date")
  result     String   @db.VarChar(32)
  confidence Decimal? @db.Decimal(5, 2)
  evidenceUrl String? @map("evidence_url")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  parcel     Parcel   @relation(fields: [parcelId], references: [id])

  @@map("eudr_deforestation_checks")
  @@index([parcelId])
}

model EudrLegalityCheck {
  id         String   @id @default(uuid()) @db.Uuid
  ddId       String   @map("dd_id") @db.Uuid
  checkType  String   @map("check_type") @db.VarChar(64)
  status     String   @db.VarChar(32)
  evidenceUrl String? @map("evidence_url")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  dd         EudrDueDiligence @relation(fields: [ddId], references: [id])

  @@map("eudr_legality_checks")
  @@index([ddId])
}

model EudrDeclaration {
  id          String   @id @default(uuid()) @db.Uuid
  ddId        String   @map("dd_id") @db.Uuid
  payloadJson Json     @map("payload_json")
  referenceNo String?  @map("reference_no") @db.VarChar(64)
  submittedBy String?  @map("submitted_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at")
  status      String   @default("draft") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  dd          EudrDueDiligence @relation(fields: [ddId], references: [id])
  submitter   User?    @relation("eudr_submitter", fields: [submittedBy], references: [id])

  @@map("eudr_declarations")
  @@index([ddId])
}

model ApiKey {
  id            String                @id @default(uuid()) @db.Uuid
  partnerName   String                @map("partner_name")
  apiKeyHash    String                @map("api_key_hash")
  cooperativeId String?               @map("cooperative_id") @db.Uuid
  status        String                @default("active")
  createdAt     DateTime              @default(now()) @map("created_at")
  cooperative   Cooperative?          @relation(fields: [cooperativeId], references: [id])
  webhooks      WebhookSubscription[]

  @@map("api_keys")
}

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  apiKeyId  String   @map("api_key_id") @db.Uuid
  url       String
  secret    String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@map("webhook_subscriptions")
}

// ==========================================
// AUDIO COLLECTOR MODULE (Isolated)
// ==========================================

model AudioLanguage {
  code      String             @id @db.VarChar(10) // 'ee', 'kbp'
  name      String             @db.VarChar(50)     // 'Ewe', 'Kabyè'
  phrases   AudioTranslation[]

  @@map("audio_languages")
}

model AudioPhrase {
  key          String             @id @db.VarChar(100) // 'welcome_msg', 'btn_new_harvest'
  frenchText   String
  translations AudioTranslation[]

  @@map("audio_phrases")
}

model AudioTranslation {
  id           String        @id @default(uuid()) @db.Uuid
  phraseKey    String        @map("phrase_key") @db.VarChar(100)
  langCode     String        @map("lang_code") @db.VarChar(10)
  audioUrl     String?       @map("audio_url")
  status       String        @default("PENDING") @db.VarChar(20) // PENDING, RECORDED
  history      Json?         @default("[]") // Store previous audioUrls when rejected
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  phrase       AudioPhrase   @relation(fields: [phraseKey], references: [key])
  language     AudioLanguage @relation(fields: [langCode], references: [code])

  @@unique([phraseKey, langCode])
  @@map("audio_translations")
}
